{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "city", "era", "site_type", "summary", "tags",
               "sections", "images", "relics"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]{3,40}$" },
    "name": { "type": "string", "minLength": 2 },
    "city": { "enum": ["sanmenxia", "luoyang", "zhengzhou", "kaifeng", "puyang"] },
    "era": { "enum": ["yangshao", "longshan", "xiashang", "zhou", "hantang", "song"] },
    "site_type": { "enum": ["capital", "burial", "kiln", "ancient_arch"] },
    "summary": { "type": "string", "minLength": 20 },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sections": {
      "type": "object",
      "required": ["intro", "arch", "events", "poems", "tourism"],
      "properties": {
        "intro": { "type": "string", "minLength": 30 },
        "arch": { "type": "string", "minLength": 30 },
        "events": {
          "anyOf": [
            { "type": "string", "minLength": 20 },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/event" } }
          ]
        },
        "poems": { "type": "array", "items": {
          "type": "object", "required": ["text", "author", "source"],
          "properties": { "text": {"type":"string","minLength":4}, "author": {"type":"string","minLength":1}, "source": {"type":"string","minLength":1} } } },
        "tourism": {
          "anyOf": [
            { "type": "string", "minLength": 10 },
            { "type": "object", "required": ["overview"], "properties": {
              "overview": { "type": "string", "minLength": 10 },
              "guide": { "type": "object", "properties": {
                "hours": { "type": "string" }, "tickets": { "type": "string" }, "address": { "type": "string" } } },
              "itinerary": { "type": "string" } } }
          ]
        }
      }
    },
    "images": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^images/[a-z0-9_]+/real_[a-z0-9_]+\\.webp$" }, "description": "首位=头图，其余=图集。2026-10-25 口径：遗址位只放外景/现场遗迹，无实拍则回退年代色（故不设 minItems）；器物实拍可进图集，故上限由 4 放宽到 16。2026-10-26 收紧为只允许 real_：头图取 firstRealImage、图集取 realImagesExclude，非实拍项写了也不上屏。" },
    "relics": { "type": "array", "minItems": 2, "maxItems": 4, "items": {
      "type": "object", "required": ["id", "name", "era", "summary", "material", "images"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]{3,40}$" },
        "name": { "type": "string", "minLength": 2 },
        "era": { "enum": ["yangshao", "longshan", "xiashang", "zhou", "hantang", "song"] },
        "summary": { "type": "string", "minLength": 20 },
        "material": { "type": "string", "minLength": 2 },
        "images": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^images/[a-z0-9_]+/real_[a-z0-9_]+\\.webp$" }, "description": "只允许实拍：渲染层（DetailPage/ListPage/RelicPage 与灯箱）全程过 isRealImage/firstRealImage，非 real_ 的项写进来也永远不上屏，只会白进 HAP。2026-10-26 据此把历史示意图引用从 42 个站点 JSON 中摘除（184 条），并把 minItems 由 1 放开为不设下限——无实拍卡走藏品签+材质剪影是设计稿制式的正式态，不是缺数据。" } } } }
  },
  "definitions": {
    "event": {
      "type": "object",
      "required": ["year", "title", "summary"],
      "properties": {
        "year": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 4 },
        "summary": { "type": "string", "minLength": 40 },
        "background": { "type": "string" },
        "process": { "type": "string" },
        "impact": { "type": "string" },
        "figures": { "type": "array", "items": { "type": "string" } },
        "furtherReading": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
